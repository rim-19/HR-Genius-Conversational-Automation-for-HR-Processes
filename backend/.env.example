# ---- Database ----
# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hrgenius?schema=public"

# ---- Auth ----
# Secret used to sign access tokens (REQUIRED — server refuses to start without it)
JWT_SECRET="replace-with-a-long-random-string"
# Secret used to sign refresh tokens (falls back to JWT_SECRET if unset)
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# ---- AI ----
# Google Gemini API key (AI features are disabled without it)
GEMINI_API_KEY="your-gemini-api-key"

# ---- Automation ----
# External n8n webhook that emails employees their generated documents
N8N_WEBHOOK_URL="http://127.0.0.1:5678/webhook/send-document-pdf"

# ---- Server ----
PORT=5000
# Base URL used when building public links to generated PDFs
API_BASE_URL="http://127.0.0.1:5000"
# Comma-separated list of allowed CORS origins (omit for open access in dev)
CORS_ORIGIN="http://localhost:5173"
# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL="info"
NODE_ENV="development"
