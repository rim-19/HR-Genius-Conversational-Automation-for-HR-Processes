// HR-Genius Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  role        Role         @default(EMPLOYEE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  employeesCreated Employee[] @relation("CreatedByUser")
  managedEmployees Employee[] @relation("ManagerUser")
  documents       Document[]  @relation("UserDocuments")
  actions         ActionLog[] @relation("UserActions")
  conversationMemory ConversationMemory?
}

model Employee {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  position     String
  department   String?
  phone        String?
  salary       Float?
  status       String     @default("active")
  joinedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  managerId    Int?
  manager      User?      @relation("ManagerUser", fields: [managerId], references: [id])

  createdById  Int?
  createdBy    User?      @relation("CreatedByUser", fields: [createdById], references: [id])

  documents    Document[]
}

model Document {
  id           Int        @id @default(autoincrement())
  title        String
  type         String
  fileUrl      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])

  createdById  Int?
  createdBy    User?      @relation("UserDocuments", fields: [createdById], references: [id])
}

model ActionLog {
  id           Int        @id @default(autoincrement())
  action       String
  description  String?
  createdAt    DateTime   @default(now())
  

  // Relations
  userId       Int
  user         User       @relation("UserActions", fields: [userId], references: [id])
}

model ConversationMemory {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  memory    Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
