datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("Employee")
  createdAt DateTime @default(now())
}

model Employee {
  id          Int       @id @default(autoincrement())
  name        String
  department  String
  position    String
  salary      Float
  joinDate    DateTime   @default(now())
  documents   Document[]
}

model Document {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  filePath    String
  type        String
  createdAt   DateTime  @default(now())
  Employee    Employee  @relation(fields: [employeeId], references: [id])
}

model Workflow {
  id         Int      @id @default(autoincrement())
  name       String
  jsonData   Json
  createdAt  DateTime @default(now())
  createdBy  Int
}
